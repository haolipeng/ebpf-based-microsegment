{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Agent (Default)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src/agent/cmd",
            "args": [
                "-c",
                "${workspaceFolder}/config/agent.yaml"
            ],
            "env": {
                "CGO_ENABLED": "1",
                "PATH": "/usr/local/go/bin:/home/work/goProject/bin:${env:PATH}"
            },
            "asRoot": true,
            "console": "integratedTerminal",
            "showLog": true,
            "trace": "verbose",
            "preLaunchTask": "build-bpf"
        },
        {
            "name": "Debug Agent (XDP Example)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src/agent/cmd",
            "args": [
                "-c",
                "${workspaceFolder}/config/agent-xdp-example.yaml"
            ],
            "env": {
                "CGO_ENABLED": "1",
                "PATH": "/usr/local/go/bin:/home/work/goProject/bin:${env:PATH}"
            },
            "asRoot": true,
            "console": "integratedTerminal",
            "showLog": true,
            "trace": "verbose",
            "preLaunchTask": "build-bpf"
        },
        {
            "name": "Debug Agent (K8s Example)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src/agent/cmd",
            "args": [
                "-c",
                "${workspaceFolder}/config/agent-k8s-example.yaml"
            ],
            "env": {
                "CGO_ENABLED": "1",
                "PATH": "/usr/local/go/bin:/home/work/goProject/bin:${env:PATH}"
            },
            "asRoot": true,
            "console": "integratedTerminal",
            "showLog": true,
            "trace": "verbose",
            "preLaunchTask": "build-bpf"
        },
        {
            "name": "Debug Agent (Custom Config)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src/agent/cmd",
            "args": [
                "-c",
                "${input:configPath}"
            ],
            "env": {
                "CGO_ENABLED": "1",
                "PATH": "/usr/local/go/bin:/home/work/goProject/bin:${env:PATH}"
            },
            "asRoot": true,
            "console": "integratedTerminal",
            "showLog": true,
            "trace": "verbose",
            "preLaunchTask": "build-bpf"
        },
        {
            "name": "Debug Server",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src/server/cmd",
            "args": [
                "-c",
                "${workspaceFolder}/config/server.yaml"
            ],
            "env": {
                "PATH": "/usr/local/go/bin:/home/work/goProject/bin:${env:PATH}"
            },
            "console": "integratedTerminal",
            "showLog": true
        },
        {
            "name": "Attach to Running Agent",
            "type": "go",
            "request": "attach",
            "mode": "local",
            "processId": "${command:pickProcess}",
            "asRoot": true
        }
    ],
    "inputs": [
        {
            "id": "configPath",
            "type": "promptString",
            "description": "Agent 配置文件路径",
            "default": "${workspaceFolder}/config/agent-tc.yaml"
        }
    ]
}
