# eBPF Microsegment Agent 环境变量示例
# 复制此文件为 agent.env 并修改值

# Server 连接
#MICROSEGMENT_SERVER_URL=http://localhost:8080

# Agent API
#MICROSEGMENT_AGENT_API_PORT=8081

# eBPF 配置
#MICROSEGMENT_EBPF_PROGRAM_PATH=/usr/local/lib/ebpf/flow_tracker_core.o

# 日志配置
#MICROSEGMENT_LOG_LEVEL=info
#MICROSEGMENT_LOG_FORMAT=json
