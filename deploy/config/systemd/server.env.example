# eBPF Microsegment Server 环境变量示例
# 复制此文件为 server.env 并修改值

# 数据库连接
#MICROSEGMENT_DB_HOST=localhost
#MICROSEGMENT_DB_PORT=5432
#MICROSEGMENT_DB_NAME=microsegment
#MICROSEGMENT_DB_USER=microsegment_user
#MICROSEGMENT_DB_PASSWORD=changeme

# 服务配置
#MICROSEGMENT_SERVER_HTTP_PORT=8080
#MICROSEGMENT_SERVER_GRPC_PORT=9090

# 日志配置
#MICROSEGMENT_LOG_LEVEL=info
#MICROSEGMENT_LOG_FORMAT=json
