# 阶段 1: 构建阶段
FROM golang:1.24 AS builder

# 设置工作目录
WORKDIR /build

# 设置 Go 代理 (加速依赖下载)
ENV GOPROXY=https://goproxy.cn,direct

# 复制所有源代码 (因为 go.mod 中有 replace 指令需要本地路径)
COPY . .

# 构建 Agent 二进制文件
RUN CGO_ENABLED=0 GOOS=linux go build -o microsegment-agent ./src/agent/cmd

# 阶段 2: 运行时阶段
FROM ubuntu:22.04

# 安装必要的运行时依赖
# iproute2: 网络管理工具 (ip 命令)
# iptables: 防火墙工具
# ca-certificates: SSL/TLS 证书
RUN apt-get update && \
    apt-get install -y \
        iproute2 \
        iptables \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# 从构建阶段复制二进制文件
COPY --from=builder /build/microsegment-agent /usr/local/bin/

# 暴露端口
# 8081: Agent API
EXPOSE 8081

# 启动命令
CMD ["/usr/local/bin/microsegment-agent", "--config", "/etc/microsegment/docker-agent.yaml"]
