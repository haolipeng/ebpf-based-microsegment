func setupPolicyRuleTest(t *testing.T) (*PolicyRuleHandler, *policy.PolicyManager, *groups.GroupManager, *workload.Manager, func()) {
	// Create temporary databases
	workloadDBPath := "/tmp/test_policyrule_api_workload_" + t.Name() + ".db"
	groupDBPath := "/tmp/test_policyrule_api_group_" + t.Name() + ".db"
	policyDBPath := "/tmp/test_policyrule_api_policy_" + t.Name() + ".db"

	workloadStorage, err := workload.NewSQLiteWorkloadStorage(workloadDBPath)
	require.NoError(t, err)

	groupStorage, err := groups.NewSQLiteGroupStorage(groupDBPath)
	require.NoError(t, err)

	policyStorage, err := policy.NewSQLiteStorage(policyDBPath)
	require.NoError(t, err)

	workloadMgr := workload.NewManager(workloadStorage)
	groupMgr := groups.NewGroupManager(groupStorage, workloadMgr)
	policyMgr := policy.NewManagerWithStorage(nil, policyStorage) // nil dataplane for testing

	// Create and set compiler
	compiler := policy.NewPolicyCompiler(policyStorage, groupMgr)
	policyMgr.SetCompiler(compiler)

	handler := NewPolicyRuleHandler(policyMgr)

	cleanup := func() {
		workloadStorage.Close()
		groupStorage.Close()
		policyStorage.Close()
		os.Remove(workloadDBPath)
		os.Remove(groupDBPath)
		os.Remove(policyDBPath)
	}

	return handler, policyMgr, groupMgr, workloadMgr, cleanup
}

func TestCreatePolicyRule(t *testing.T) {
	handler, _, groupMgr, workloadMgr, cleanup := setupPolicyRuleTest(t)
	defer cleanup()

	// Create workloads
	w1 := &workload.Workload{
		ID:   "web-1",
		HostID: "test-host",
		Name: "Web 1",
		IPs:  []net.IP{net.ParseIP("10.0.1.10")},
		Labels: map[string]string{
			"tier": "frontend",
		},
	}
	w2 := &workload.Workload{
		ID:   "api-1",
		HostID: "test-host",
		Name: "API 1",
		IPs:  []net.IP{net.ParseIP("10.0.2.20")},
		Labels: map[string]string{
			"tier": "backend",
		},
	}
	err := workloadMgr.CreateWorkload(w1)
	require.NoError(t, err)
	err = workloadMgr.CreateWorkload(w2)
	require.NoError(t, err)

	// Create groups
	frontendGroup := groups.NewGroup("frontend-group")
	frontendGroup.AddSelector(groups.NewEqualSelector("tier", "frontend"))
	err = groupMgr.CreateGroup(frontendGroup)
	require.NoError(t, err)

	backendGroup := groups.NewGroup("backend-group")
	backendGroup.AddSelector(groups.NewEqualSelector("tier", "backend"))
	err = groupMgr.CreateGroup(backendGroup)
	require.NoError(t, err)

	gin.SetMode(gin.TestMode)
	router := gin.New()
	router.POST("/policy-rules", handler.CreatePolicyRule)

	tests := []struct {
		name           string
		requestBody    models.PolicyRuleRequest
		expectedStatus int
		checkResponse  func(*testing.T, *httptest.ResponseRecorder)
	}{
		{
			name: "valid policy rule",
			requestBody: models.PolicyRuleRequest{
				Name:        "frontend-to-backend",
				Description: "Allow frontend to backend",
				FromGroup:   "frontend-group",
				ToGroup:     "backend-group",
				Ports: []models.PortRangeRequest{
					{Start: 80, End: 80, Protocol: "tcp"},
					{Start: 443, End: 443, Protocol: "tcp"},
				},
				Action:   "allow",
				Priority: 100,
				Enabled:  true,
			},
			expectedStatus: http.StatusCreated,
			checkResponse: func(t *testing.T, w *httptest.ResponseRecorder) {
				var response models.PolicyRuleResponse
				err := json.Unmarshal(w.Body.Bytes(), &response)
				require.NoError(t, err)
				assert.Equal(t, "frontend-to-backend", response.Name)
				assert.Equal(t, "frontend-group", response.FromGroup)
				assert.Equal(t, "backend-group", response.ToGroup)
				assert.Len(t, response.Ports, 2)
				assert.True(t, response.ID > 0)
			},
		},
		{
			name: "missing required fields",
			requestBody: models.PolicyRuleRequest{
				Name: "incomplete-rule",
			},
			expectedStatus: http.StatusBadRequest,
			checkResponse: func(t *testing.T, w *httptest.ResponseRecorder) {
				var response models.ErrorResponse
				err := json.Unmarshal(w.Body.Bytes(), &response)
				require.NoError(t, err)
				assert.Equal(t, "validation_error", response.Error)
			},
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			body, err := json.Marshal(tt.requestBody)
			require.NoError(t, err)

			req, err := http.NewRequest(http.MethodPost, "/policy-rules", bytes.NewBuffer(body))
			require.NoError(t, err)
			req.Header.Set("Content-Type", "application/json")

			w := httptest.NewRecorder()
			router.ServeHTTP(w, req)

			assert.Equal(t, tt.expectedStatus, w.Code)
			if tt.checkResponse != nil {
				tt.checkResponse(t, w)
			}
		})
	}
}

func TestListPolicyRules(t *testing.T) {
	handler, policyMgr, groupMgr, workloadMgr, cleanup := setupPolicyRuleTest(t)
	defer cleanup()

	// Create workloads and groups
	w1 := &workload.Workload{
		ID:     "web-1",
		HostID: "test-host",
		Name:   "Web 1",
		IPs:    []net.IP{net.ParseIP("10.0.1.10")},
		Labels: map[string]string{"tier": "frontend"},
	}
	w2 := &workload.Workload{
		ID:     "api-1",
		HostID: "test-host",
		Name:   "API 1",
		IPs:    []net.IP{net.ParseIP("10.0.2.20")},
		Labels: map[string]string{"tier": "backend"},
	}
	workloadMgr.CreateWorkload(w1)
	workloadMgr.CreateWorkload(w2)

	frontendGroup := groups.NewGroup("frontend-group")
	frontendGroup.AddSelector(groups.NewEqualSelector("tier", "frontend"))
	groupMgr.CreateGroup(frontendGroup)

	backendGroup := groups.NewGroup("backend-group")
	backendGroup.AddSelector(groups.NewEqualSelector("tier", "backend"))
	groupMgr.CreateGroup(backendGroup)

	// Create policy rules
	rule1 := &policy.PolicyRule{
		Name:      "rule-1",
		FromGroup: "frontend-group",
		ToGroup:   "backend-group",
		Ports: []policy.PortRange{
			{Start: 80, End: 80, Protocol: "tcp"},
		},
		Action:   "allow",
		Priority: 100,
		Enabled:  true,
	}
	err := policyMgr.AddPolicyRule(rule1)
	require.NoError(t, err)

	gin.SetMode(gin.TestMode)
	router := gin.New()
	router.GET("/policy-rules", handler.ListPolicyRules)

	req, err := http.NewRequest(http.MethodGet, "/policy-rules", nil)
	require.NoError(t, err)

	w := httptest.NewRecorder()
	router.ServeHTTP(w, req)

	assert.Equal(t, http.StatusOK, w.Code)

	var response models.PolicyRuleListResponse
	err = json.Unmarshal(w.Body.Bytes(), &response)
	require.NoError(t, err)

	assert.Equal(t, 1, response.Count)
	assert.Len(t, response.Rules, 1)
	assert.Equal(t, "rule-1", response.Rules[0].Name)
}

func TestGetPolicyRule(t *testing.T) {
	handler, policyMgr, groupMgr, workloadMgr, cleanup := setupPolicyRuleTest(t)
	defer cleanup()

	// Setup workloads and groups
	w1 := &workload.Workload{
		ID:     "web-1",
		HostID: "test-host",
		Name:   "Web 1",
		IPs:    []net.IP{net.ParseIP("10.0.1.10")},
		Labels: map[string]string{"tier": "frontend"},
	}
	w2 := &workload.Workload{
		ID:     "api-1",
		HostID: "test-host",
		Name:   "API 1",
		IPs:    []net.IP{net.ParseIP("10.0.2.20")},
		Labels: map[string]string{"tier": "backend"},
	}
	workloadMgr.CreateWorkload(w1)
	workloadMgr.CreateWorkload(w2)

	frontendGroup := groups.NewGroup("frontend-group")
	frontendGroup.AddSelector(groups.NewEqualSelector("tier", "frontend"))
	groupMgr.CreateGroup(frontendGroup)

	backendGroup := groups.NewGroup("backend-group")
	backendGroup.AddSelector(groups.NewEqualSelector("tier", "backend"))
	groupMgr.CreateGroup(backendGroup)

	// Create policy rule
	rule := &policy.PolicyRule{
		Name:      "test-rule",
		FromGroup: "frontend-group",
		ToGroup:   "backend-group",
		Ports: []policy.PortRange{
			{Start: 443, End: 443, Protocol: "tcp"},
		},
		Action:   "allow",
		Priority: 100,
		Enabled:  true,
	}
	err := policyMgr.AddPolicyRule(rule)
	require.NoError(t, err)

	gin.SetMode(gin.TestMode)
	router := gin.New()
	router.GET("/policy-rules/:id", handler.GetPolicyRule)

	tests := []struct {
		name           string
		ruleID         string
		expectedStatus int
		checkResponse  func(*testing.T, *httptest.ResponseRecorder)
	}{
		{
			name:           "existing rule",
			ruleID:         "1",
			expectedStatus: http.StatusOK,
			checkResponse: func(t *testing.T, w *httptest.ResponseRecorder) {
				var response models.PolicyRuleResponse
				err := json.Unmarshal(w.Body.Bytes(), &response)
				require.NoError(t, err)
				assert.Equal(t, "test-rule", response.Name)
			},
		},
		{
			name:           "non-existent rule",
			ruleID:         "999",
			expectedStatus: http.StatusNotFound,
			checkResponse: func(t *testing.T, w *httptest.ResponseRecorder) {
				var response models.ErrorResponse
				err := json.Unmarshal(w.Body.Bytes(), &response)
				require.NoError(t, err)
				assert.Equal(t, "not_found", response.Error)
			},
		},
		{
			name:           "invalid rule ID",
			ruleID:         "invalid",
			expectedStatus: http.StatusBadRequest,
			checkResponse: func(t *testing.T, w *httptest.ResponseRecorder) {
				var response models.ErrorResponse
				err := json.Unmarshal(w.Body.Bytes(), &response)
				require.NoError(t, err)
				assert.Equal(t, "validation_error", response.Error)
			},
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			req, err := http.NewRequest(http.MethodGet, "/policy-rules/"+tt.ruleID, nil)
			require.NoError(t, err)

			w := httptest.NewRecorder()
			router.ServeHTTP(w, req)

			assert.Equal(t, tt.expectedStatus, w.Code)
			if tt.checkResponse != nil {
				tt.checkResponse(t, w)
			}
		})
	}
}

func TestGetCompiledPolicies(t *testing.T) {
	handler, policyMgr, groupMgr, workloadMgr, cleanup := setupPolicyRuleTest(t)
	defer cleanup()

	// Setup workloads and groups
	w1 := &workload.Workload{
		ID:     "web-1",
		HostID: "test-host",
		Name:   "Web 1",
		IPs:    []net.IP{net.ParseIP("10.0.1.10")},
		Labels: map[string]string{"tier": "frontend"},
	}
	w2 := &workload.Workload{
		ID:     "api-1",
		HostID: "test-host",
		Name:   "API 1",
		IPs:    []net.IP{net.ParseIP("10.0.2.20")},
		Labels: map[string]string{"tier": "backend"},
	}
	workloadMgr.CreateWorkload(w1)
	workloadMgr.CreateWorkload(w2)

	frontendGroup := groups.NewGroup("frontend-group")
	frontendGroup.AddSelector(groups.NewEqualSelector("tier", "frontend"))
	groupMgr.CreateGroup(frontendGroup)

	backendGroup := groups.NewGroup("backend-group")
	backendGroup.AddSelector(groups.NewEqualSelector("tier", "backend"))
	groupMgr.CreateGroup(backendGroup)

	// Create policy rule with 2 ports (should generate 2 compiled policies)
	rule := &policy.PolicyRule{
		Name:      "test-compiled",
		FromGroup: "frontend-group",
		ToGroup:   "backend-group",
		Ports: []policy.PortRange{
			{Start: 80, End: 80, Protocol: "tcp"},
			{Start: 443, End: 443, Protocol: "tcp"},
		},
		Action:   "allow",
		Priority: 100,
		Enabled:  true,
	}
	err := policyMgr.AddPolicyRule(rule)
	require.NoError(t, err)

	gin.SetMode(gin.TestMode)
	router := gin.New()
	router.GET("/policy-rules/:id/compiled", handler.GetCompiledPolicies)

	req, err := http.NewRequest(http.MethodGet, "/policy-rules/1/compiled", nil)
	require.NoError(t, err)

	w := httptest.NewRecorder()
	router.ServeHTTP(w, req)

	assert.Equal(t, http.StatusOK, w.Code)

	var response models.CompiledPoliciesResponse
	err = json.Unmarshal(w.Body.Bytes(), &response)
	require.NoError(t, err)

	// 1 frontend × 1 backend × 2 ports = 2 compiled policies
	assert.Equal(t, 2, response.Count)
	assert.Len(t, response.Policies, 2)

	// Verify traceability fields
	for _, cp := range response.Policies {
		assert.Equal(t, uint32(1), cp.SourceRuleID)
		assert.Equal(t, "frontend-group", cp.FromGroup)
		assert.Equal(t, "backend-group", cp.ToGroup)
		assert.Equal(t, "web-1", cp.FromWorkloadID)
		assert.Equal(t, "api-1", cp.ToWorkloadID)
		HostID: "test-host",
		assert.NotEmpty(t, cp.CompilationTime)
	}
}

func TestDeletePolicyRule(t *testing.T) {
	handler, policyMgr, groupMgr, workloadMgr, cleanup := setupPolicyRuleTest(t)
	defer cleanup()

	// Setup workloads and groups
	w1 := &workload.Workload{
		ID:     "web-1",
		HostID: "test-host",
		Name:   "Web 1",
		IPs:    []net.IP{net.ParseIP("10.0.1.10")},
		Labels: map[string]string{"tier": "frontend"},
	}
	w2 := &workload.Workload{
		ID:     "api-1",
		HostID: "test-host",
		Name:   "API 1",
		IPs:    []net.IP{net.ParseIP("10.0.2.20")},
		Labels: map[string]string{"tier": "backend"},
	}
	workloadMgr.CreateWorkload(w1)
	workloadMgr.CreateWorkload(w2)

	frontendGroup := groups.NewGroup("frontend-group")
	frontendGroup.AddSelector(groups.NewEqualSelector("tier", "frontend"))
	groupMgr.CreateGroup(frontendGroup)

	backendGroup := groups.NewGroup("backend-group")
	backendGroup.AddSelector(groups.NewEqualSelector("tier", "backend"))
	groupMgr.CreateGroup(backendGroup)

	// Create policy rule
	rule := &policy.PolicyRule{
		Name:      "test-delete",
		FromGroup: "frontend-group",
		ToGroup:   "backend-group",
		Ports: []policy.PortRange{
			{Start: 80, End: 80, Protocol: "tcp"},
		},
		Action:   "allow",
		Priority: 100,
		Enabled:  true,
	}
	err := policyMgr.AddPolicyRule(rule)
	require.NoError(t, err)

	gin.SetMode(gin.TestMode)
	router := gin.New()
	router.DELETE("/policy-rules/:id", handler.DeletePolicyRule)

	req, err := http.NewRequest(http.MethodDelete, "/policy-rules/1", nil)
	require.NoError(t, err)

	w := httptest.NewRecorder()
	router.ServeHTTP(w, req)

	assert.Equal(t, http.StatusOK, w.Code)

	var response map[string]string
	err = json.Unmarshal(w.Body.Bytes(), &response)
	require.NoError(t, err)
	assert.Contains(t, response["message"], "deleted successfully")

	// Verify rule was deleted
	_, err = policyMgr.GetPolicyRule(1)
	assert.Error(t, err)
}
