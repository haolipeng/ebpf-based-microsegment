FROM golang:1.21-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache git make gcc musl-dev clang llvm

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY src/ ./src/
COPY proto/ ./proto/

# Build agent (without eBPF for testing)
WORKDIR /build/src/agent
RUN go build -o /app/microsegment-agent ./cmd

FROM alpine:latest

WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache ca-certificates iproute2

# Copy binary
COPY --from=builder /app/microsegment-agent /app/

# Copy test flow generator script
COPY tests/e2e/generate-flows.sh /app/

RUN chmod +x /app/generate-flows.sh

ENTRYPOINT ["/app/generate-flows.sh"]
