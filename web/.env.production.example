# Production Environment Variables Example
# Copy this file to .env.production and configure for your environment

# API Base URL - Full URL including protocol and port
# Example: http://192.168.1.100:8080
# The /api path is appended automatically
VITE_API_BASE_URL=http://your-server-address:8080

# API request timeout in milliseconds (optional, default: 10000)
# VITE_API_TIMEOUT=10000
